# Sao chép thành .env (đã gitignore) rồi đặt giá trị thật. KHÔNG commit .env, KHÔNG dán secret vào chat.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Đăng nhập mật khẩu: CHỈ để chạy ma trận kiểm thử / evidence barem. Đặt false khi đã có GitHub OAuth.
ENABLE_PASSWORD_LOGIN=true
USER_PASSWORD=doi-mat-khau-user
ADMIN_PASSWORD=doi-mat-khau-admin

# Đăng nhập GitHub (đặt đủ cả 4, hoặc bỏ trống cả 4).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
ADMIN_GITHUB_LOGIN=
# true khi chạy sau HTTPS (cookie chỉ gửi qua HTTPS)
COOKIE_SECURE=false

# Nạp 2 paper mẫu khi DB trống (chỉ demo/local).
SEED_DEMO=true
APP_VERSION=dev
# Chạy `go run` ngoài Docker (từ app/api) thì thêm 2 dòng:
#   DB_PATH=data/app.db
#   WEB_DIR=../web        # API phục vụ luôn giao diện, mở http://localhost:8080
# Chạy bằng docker compose thì giao diện ở http://localhost:8081 (nginx), không cần WEB_DIR.
